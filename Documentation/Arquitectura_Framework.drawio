        <!-- ══════════════════ TÍTULO + LEYENDA ══════════════════ -->
        <mxCell id="title" value="&lt;div style=&#39;font-size:22px;font-weight:700;font-family:Helvetica;&#39;&gt;Playwright Enterprise Template &amp;mdash; Arquitectura de Carpetas y Componentes&lt;/div&gt;&lt;div style=&#39;font-size:13px;color:#555555;margin-top:4px;font-family:Helvetica;&#39;&gt;C&amp;oacute;mo un flujo grabado (o un curl pegado) se convierte, v&amp;iacute;a agentes de IA, en 8 tipos de prueba automatizada&lt;/div&gt;&lt;div style=&#39;font-size:11px;margin-top:10px;font-family:Helvetica;&#39;&gt;&lt;font color=&#39;#D6B656&#39;&gt;&amp;#9679;&lt;/font&gt; Insumos&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#666666&#39;&gt;&amp;#9679;&lt;/font&gt; Configuraci&amp;oacute;n ra&amp;iacute;z&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#9673A6&#39;&gt;&amp;#9679;&lt;/font&gt; Motor de agentes IA&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#6C8EBF&#39;&gt;&amp;#9679;&lt;/font&gt; Runtime compartido&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#999999&#39;&gt;&amp;#9679;&lt;/font&gt; Documentaci&amp;oacute;n&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#D79B00&#39;&gt;&amp;#9679;&lt;/font&gt; Orquestador&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#82B366&#39;&gt;&amp;#9679;&lt;/font&gt; Salida generada&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#B85450&#39;&gt;&amp;#9679;&lt;/font&gt; Aprendizaje / feedback&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1560" height="72" as="geometry" />
        </mxCell>

        <!-- ══════════════════ ROW LABELS ══════════════════ -->
        <mxCell id="rl1" value="① INSUMOS DEL TESTER — lo único que se captura a mano" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#8C7326;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="700" height="22" as="geometry" /></mxCell>
