<mxfile host="app.diagrams.net">
  <diagram name="Tipos de Prueba" id="zdaYSkXcDIwMadqZzl1w">
    <mxGraphModel dx="1174" dy="747" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-1" parent="1" style="text;html=1;align=left;verticalAlign=top;spacing=0;" value="&lt;div style=&#39;font-size:22px;font-weight:700;font-family:Helvetica;&#39;&gt;Tipos de prueba que genera y ejecuta el framework&lt;/div&gt;&lt;div style=&#39;font-size:13px;color:#555555;margin-top:4px;font-family:Helvetica;&#39;&gt;Qué valida cada tipo, de dónde sale y cómo se ejecuta — con ejemplos reales de la suite Homebanking_Tarjeta_Virtual&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="1300" x="60" y="10" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacing=10;fontSize=12;fillColor=#EFF6FF;strokeColor=#6C8EBF;strokeWidth=1.5;" value="&lt;b&gt;🎬 Un mismo flujo grabado&lt;/b&gt; (o un curl pegado, para API) alimenta los 8 tipos de abajo — no hay que escribirlos por separado. Cada uno corre como un proyecto independiente de Playwright y aparece como su propia pestaña, con % de éxito propio, en el portal de reportes." vertex="1">
          <mxGeometry height="56" width="1400" x="60" y="78" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;🖥️ UI / Frontend&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#6C8EBF;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;BoxRecordings/&amp;lt;Suite&amp;gt;.ts — grabación de Playwright codegen&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#6C8EBF;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;proyectos ui-chromium, ui-firefox, ui-webkit — 3 navegadores reales en paralelo&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#6C8EBF;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;cada clic, fill y select del flujo grabado; selectores con auto-reparación en 3 niveles si la interfaz cambia&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#6C8EBF;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;Homebanking_Tarjeta_Virtual.spec.ts — login → generar tarjeta virtual → confirmar (×2 filas de BoxTestData)&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="60" y="160" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;🔗 API — REST y SOAP&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#9673A6;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;BoxAPIsExecute/{REST,SOAP}/ — curl/URL reales pegados (Box_Example_Apis es solo plantilla de referencia)&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#9673A6;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;proyecto api — peticiones HTTP directas, sin navegador&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#9673A6;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;3 casos por endpoint: Éxito (2xx), Error técnico (servicio no disponible), Error de datos (4xx); en SOAP valida además el envelope XML de respuesta&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#9673A6;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;Homebanking_Tarjeta_Virtual_SOAP_POST.spec.ts — SOAP Add: Éxito ×2 filas + Error técnico + Error de datos&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="780" y="160" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;⚡ Performance&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#D79B00;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;la misma grabación de UI — mide la página real, no hace falta grabar aparte&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#D79B00;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;proyecto performance&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#D79B00;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;tiempo de carga (&amp;lt;10000ms) · Core Web Vitals: LCP&amp;lt;4000ms, CLS&amp;lt;0.25, TBT&amp;lt;600ms · conteo de recursos de red — presupuestos configurables por variable de entorno&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#D79B00;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;Homebanking_Tarjeta_Virtual-performance.spec.ts — page load time, Core Web Vitals, network resources count&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="60" y="470" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#D4EEEA;strokeColor=#1B7A72;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;♿ Accesibilidad&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#1B7A72;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;la misma grabación de UI&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#1B7A72;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;proyecto accessibility — motor axe-core&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#1B7A72;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;escaneo automático contra los criterios WCAG 2A, 2AA y 2.1AA — reporta violaciones críticas de accesibilidad&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#1B7A72;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;Homebanking_Tarjeta_Virtual-accessibility.spec.ts — axe scan sin violaciones críticas&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="780" y="470" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#F7D9E3;strokeColor=#C2547E;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;🖼️ Visual&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C2547E;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;la misma grabación de UI&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C2547E;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;proyecto visual — comparación de capturas de pantalla&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C2547E;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;regresión visual en 2 resoluciones — desktop 1280×720 y mobile 375×812 — contra una captura base, con tolerancia de diferencia configurable&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C2547E;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;Homebanking_Tarjeta_Virtual-visual.spec.ts — screenshot desktop + screenshot mobile&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="60" y="780" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#F8CECC;strokeColor=#C0392B;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;🔒 Seguridad&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C0392B;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;la misma grabación de UI&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C0392B;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;proyecto security — 3 archivos por suite&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C0392B;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;headers HTTP, inyección SQL y XSS · HTTPS obligatorio + redirect + header HSTS · fuerza bruta vía API y UI, sin enumeración de usuarios&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#C0392B;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;-security.spec.ts · -https-enforcement.spec.ts · -authentication-bruteforce.spec.ts&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="780" y="780" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;📈 No funcional (carga)&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#5A8A4A;font-weight:700;margin-top:10px;&#39;&gt;SE GENERA DESDE&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;la grabación / endpoints de API, con npm run generate:nf — paso aparte, no automático&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#5A8A4A;font-weight:700;margin-top:9px;&#39;&gt;SE EJECUTA CON&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;motor propio estilo JMeter (GenerateTest/non-functional) — sin navegador&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#5A8A4A;font-weight:700;margin-top:9px;&#39;&gt;QUÉ VALIDA&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;comportamiento bajo carga: incremental (rampa lineal de usuarios virtuales) y spike (picos definidos), configurables y ejecutables en simultáneo&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#5A8A4A;font-weight:700;margin-top:9px;&#39;&gt;EJEMPLO REAL EN ESTE PROYECTO&lt;/div&gt;&lt;div style=&#39;font-size:10.5px;font-family:monospace;color:#444444;&#39;&gt;nf-config.ts — SOAP Calculator INCREMENTAL + SPIKE sobre el mismo servicio&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="60" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1.5;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;📊 Cómo se ve en el reporte&lt;/div&gt;&lt;div style=&#39;font-size:11px;margin-top:10px;&#39;&gt;portal.html tiene una pestaña por cada uno de los 7 tipos evaluables de arriba, con:&lt;/div&gt;&lt;div style=&#39;font-size:11px;margin-top:6px;&#39;&gt;• % de éxito, pasaron/fallaron/total&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;• video, trazas y capturas por prueba&lt;/div&gt;&lt;div style=&#39;font-size:11px;&#39;&gt;• los datos de BoxTestData usados en cada fila (si aplica)&lt;/div&gt;&lt;div style=&#39;font-size:11px;margin-top:8px;color:#777777;&#39;&gt;(esta caja es un resumen, no un 9° tipo de prueba)&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="680" x="780" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-11" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#777777;" value="ℹ️ No es un 9° tipo de prueba — es la narración del mismo flujo de UI" vertex="1">
          <mxGeometry height="22" width="700" x="60" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#F0F0F0;strokeColor=#999999;strokeWidth=2;dashed=1;" value="&lt;div style=&#39;font-size:15px;font-weight:700;&#39;&gt;📖 BDD / Gherkin — informativo&lt;/div&gt;&lt;table style=&#39;width:100%;margin-top:10px;font-size:11px;&#39;&gt;&lt;tr&gt;&lt;td style=&#39;width:20%;font-weight:700;color:#777777;vertical-align:top;&#39;&gt;SE GENERA DESDE&lt;/td&gt;&lt;td&gt;la misma grabación de UI, traducida a Gherkin por IA (tag @UI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;font-weight:700;color:#777777;vertical-align:top;padding-top:6px;&#39;&gt;SE EJECUTA CON&lt;/td&gt;&lt;td style=&#39;padding-top:6px;&#39;&gt;proyecto bdd-ui (requiere storage/auth.json)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;font-weight:700;color:#777777;vertical-align:top;padding-top:6px;&#39;&gt;QUÉ ES&lt;/td&gt;&lt;td style=&#39;padding-top:6px;&#39;&gt;la narración en lenguaje natural del MISMO flujo de UI ya evaluado arriba — legible por negocio y QA. En el portal vive en su propia pestaña informativa, SIN % de éxito propio.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="60" y="1428" as="geometry" />
        </mxCell>
        <mxCell id="RgzY3qbrkUxtfzSBJmYS-13" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="514" width="265" x="1320" y="1640" as="geometry" />
