<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0" type="device">
  <diagram name="MCP, Agentes e IA" id="mcp-agentes-ia-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ══════════════════ TÍTULO + LEYENDA ══════════════════ -->
        <mxCell id="title" value="&lt;div style=&#39;font-size:22px;font-weight:700;font-family:Helvetica;&#39;&gt;MCP, Agentes e IA &amp;mdash; cómo funciona la inteligencia del framework&lt;/div&gt;&lt;div style=&#39;font-size:13px;color:#555555;margin-top:4px;font-family:Helvetica;&#39;&gt;Tres piezas distintas que suelen confundirse: un canal interactivo (MCP), un motor de reglas (Agentes) y puntos puntuales de IA generativa&lt;/div&gt;&lt;div style=&#39;font-size:11px;margin-top:10px;font-family:Helvetica;&#39;&gt;&lt;font color=&#39;#6C8EBF&#39;&gt;&amp;#9679;&lt;/font&gt; MCP — canal interactivo&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#82B366&#39;&gt;&amp;#9679;&lt;/font&gt; Agentes — motor determinístico&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#CC6B49&#39;&gt;&amp;#9679;&lt;/font&gt; IA generativa — 7 puntos de intervención&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1280" height="72" as="geometry" />
        </mxCell>

        <!-- ══════════════════ SECCIÓN A — MCP ══════════════════ -->
        <mxCell id="secA" value="🔌 MCP — el canal interactivo (no genera pruebas)" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#4D6E96;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="900" height="22" as="geometry" /></mxCell>
        <mxCell id="secAsub" value="Conecta un asistente de IA (Claude Code, un IDE) con un navegador real, para explorar o depurar un flujo ANTES de grabarlo — corre aparte del motor de generación" style="text;html=1;fontSize=11.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="1000" height="20" as="geometry" /></mxCell>

        <mxCell id="grp" value="canal interactivo (npm run mcp:server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontSize=10.5;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1000" height="150" as="geometry" /></mxCell>

        <mxCell id="a1" value="&lt;b&gt;Asistente de IA&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;&#39;&gt;Claude Code · IDE con MCP&lt;br&gt;explora o depura un flujo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=13;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Servidor MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;&#39;&gt;ConfigurationAgents/.../mcp/server.ts&lt;br&gt;envuelve @playwright/mcp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=13;fontStyle=1;fillColor=#EFF6FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="175" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Navegador real&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;&#39;&gt;sesión Playwright&lt;br&gt;headed / headless&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=13;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="175" width="260" height="100" as="geometry" /></mxCell>

        <mxCell id="ae1" value="comando (navegar, clic, capturar)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10.5;strokeColor=#4D6E96;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" value="resultado / DOM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10.5;strokeColor=#8CA6C4;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" value="controla la sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10.5;strokeColor=#4D6E96;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" value="estado / captura" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10.5;strokeColor=#8CA6C4;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="mc1" value="&lt;b&gt;✅ Para qué sirve&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;&#39;&gt;• Explorar un flujo antes de grabarlo&lt;br&gt;• Depurar por qué un paso falla, viendo el navegador en vivo&lt;br&gt;• Probar selectores manualmente desde el asistente de IA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=13;fontStyle=1;fillColor=#EAF7ED;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="460" height="130" as="geometry" /></mxCell>
        <mxCell id="mc2" value="&lt;b&gt;🚫 Qué NO hace&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;&#39;&gt;• No genera las 8 suites de prueba (eso lo hace el motor de Agentes)&lt;br&gt;• No corre en cada npm test — es una herramienta manual de diseño&lt;br&gt;• No sustituye la grabación con Playwright codegen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=13;fontStyle=1;fillColor=#FBEAE8;strokeColor=#C0392B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="315" width="460" height="130" as="geometry" /></mxCell>

        <!-- ══════════════════ SECCIÓN B — AGENTES ══════════════════ -->
        <mxCell id="secB" value="⚙️ Los Agentes — el motor determinístico" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#5A8A4A;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="900" height="22" as="geometry" /></mxCell>
        <mxCell id="secBsub" value="Corre siempre igual para el mismo insumo, sin necesitar IA ni conexión a internet — es la columna vertebral del framework" style="text;html=1;fontSize=11.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="497" width="1100" height="20" as="geometry" /></mxCell>

        <mxCell id="b1" value="&lt;b&gt;1 · Generación&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;&#39;&gt;• Parser normaliza cada paso grabado (clic, fill, select…)&lt;br&gt;• Selector-engine arma localizadores robustos (rol, texto, testId)&lt;br&gt;• Generadores por tipo escriben las 8 suites (ui, api, performance…)&lt;br&gt;• Agente de red detecta llamadas API dentro de la grabación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="380" height="270" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;2 · Ejecución&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;&#39;&gt;• 3 navegadores en paralelo + reintentos automáticos (retries=2)&lt;br&gt;• Si un selector falla: reintenta → recarga la página → prueba variantes (rol, texto, testId, Shadow DOM)&lt;br&gt;• Learning Store elige el selector con mejor historial antes de reintentar&lt;br&gt;• Solo si TODO lo anterior falla, se escala a IA (ver sección siguiente)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="525" width="380" height="270" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;3 · Reporte&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;&#39;&gt;• Junta los resultados de las 8 suites en un solo XML&lt;br&gt;• Arma portal.html con video, trazas, capturas y los datos de prueba usados&lt;br&gt;• Calcula % de éxito por tipo de prueba&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="525" width="380" height="270" as="geometry" /></mxCell>

        <mxCell id="be1" value="ejecuta la suite generada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#5A8A4A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" value="resultados JUnit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#5A8A4A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ══════════════════ SECCIÓN C — IA ══════════════════ -->
        <mxCell id="secC" value="🤖 La IA — 7 puntos de intervención puntual (OpenAI gpt-4o-mini)" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#B5502E;" vertex="1" parent="1"><mxGeometry x="40" y="825" width="1000" height="22" as="geometry" /></mxCell>
        <mxCell id="secCsub" value="La IA nunca reemplaza al motor de reglas: solo decide en los puntos donde una regla fija no alcanza — ambigüedad, emparejamiento o redacción en lenguaje natural" style="text;html=1;fontSize=11.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="847" width="1200" height="20" as="geometry" /></mxCell>

        <mxCell id="c1" value="1 · Generación" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#F2F2F2;strokeColor=#AAAAAA;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="380" height="46" as="geometry" /></mxCell>
        <mxCell id="c2" value="2 · Ejecución" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#F2F2F2;strokeColor=#AAAAAA;" vertex="1" parent="1"><mxGeometry x="480" y="880" width="380" height="46" as="geometry" /></mxCell>
        <mxCell id="c3" value="3 · Reporte" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#F2F2F2;strokeColor=#AAAAAA;" vertex="1" parent="1"><mxGeometry x="900" y="880" width="380" height="46" as="geometry" /></mxCell>

        <mxCell id="cc1" value="&lt;b&gt;① Detecta intención ambigua&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;flow-validator.ts — cuando un paso grabado no calza con ningún patrón conocido, la IA clasifica qué acción es&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="946" width="380" height="88" as="geometry" /></mxCell>
        <mxCell id="cc2" value="&lt;b&gt;② Redacta las validaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;assertion-engine.ts — a partir de los pasos grabados, decide qué expect() agregar al test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1046" width="380" height="88" as="geometry" /></mxCell>
        <mxCell id="cc3" value="&lt;b&gt;③ Empareja datos con campos&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;data-binding.agent.ts — ej. columna Usuario del CSV → campo de login del formulario&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1146" width="380" height="88" as="geometry" /></mxCell>
        <mxCell id="cc4" value="&lt;b&gt;④ Ubica la suite / redacta el spec de API&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;box-api-executor.agent.ts — cuando el nombre del curl pegado no calza exacto con ninguna suite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="380" height="88" as="geometry" /></mxCell>

        <mxCell id="cc5" value="&lt;b&gt;⑤ Propone un selector nuevo&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;healer-agents.ts — último recurso: analiza el DOM real cuando ninguna estrategia de regla encontró el elemento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="946" width="380" height="88" as="geometry" /></mxCell>
        <mxCell id="cc6" value="&lt;b&gt;⑥ Sugiere una acción de recuperación&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;flow-healer.ts — si un paso falla de forma inesperada (no solo por falta del elemento), con límite de 10s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="1046" width="380" height="88" as="geometry" /></mxCell>

        <mxCell id="cc7" value="&lt;b&gt;⑦ Redacta la conclusión ejecutiva&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10.5px;&#39;&gt;generate-portal.js — interpreta los resultados de las pruebas de carga en lenguaje de negocio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1;fillColor=#FBE0D3;strokeColor=#CC6B49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="946" width="380" height="88" as="geometry" /></mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CC6B49;strokeWidth=1.5;dashed=1;endArrow=none;" edge="1" parent="1" source="c1" target="cc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CC6B49;strokeWidth=1.5;dashed=1;endArrow=none;" edge="1" parent="1" source="c2" target="cc5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CC6B49;strokeWidth=1.5;dashed=1;endArrow=none;" edge="1" parent="1" source="c3" target="cc7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="fn1" value="&lt;b&gt;⚠️ Las 7 intervenciones son opcionales y con tiempo límite:&lt;/b&gt; sin OPENAI_API_KEY configurada, o si la IA no responde a tiempo, el framework sigue funcionando con su comportamiento determinista — la IA nunca es un punto único de falla." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacing=10;fontSize=12;fillColor=#FFF7E6;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1354" width="1220" height="80" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
